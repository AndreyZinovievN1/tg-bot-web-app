BOT_TOKEN=123456:replace_with_botfather_token

# Можно использовать один DATABASE_URL:
# DATABASE_URL=postgres://space_user:space_password@127.0.0.1:5432/space_db

# Или поля как в .env бота:
DB_USER=postgres
DB_PASSWORD=spacethebest
DB_NAME=ispacerobotdb
DB_HOST=localhost
DB_PORT=5432
SKINS_DIR=/home/joy/iSpaceRobot/app/user/skins

# Также поддерживаются PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
# PGSSL=false
#
# Если при старте ошибки "must be owner of table ..." — один раз от владельца БД:
# psql -U postgres -d ispacerobotdb -f server/admin_setup.sql
# и выдай права приложению: GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO DB_USER;

PORT=3001

# Ссылка «написать в поддержку» в блоке помощи раздела «Документация».
# Пример: VITE_SUPPORT_URL=https://t.me/your_support
# Если пусто — кнопка не показывается, остаётся текст-подсказка.
VITE_SUPPORT_URL=

# Только для локальной проверки вне Telegram. На проде оставь false.
ALLOW_DEV_AUTH=false
DEV_CHAT_ID=
# Владелец, которому разрешён первый вход в админку: первый ввод (фигура или код
# из 4/8 цифр) станет его способом входа. Дальше способы меняются кнопкой «Доступ».
ADMIN_BOOTSTRAP_CHAT_ID=

# 0 отключает проверку давности initData, 86400 = сутки.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Подарки Telegram: каталог и Lottie-анимации берутся из юзербота
# (aiohttp-слой `app/user_bot/gifts_api.py`, по умолчанию 127.0.0.1:8090).
# Мини-апп не ходит в юзербот напрямую: `server/giftsApi.js` проксирует
# GET /api/gifts (каталог для bootstrap) и открытый GET /api/gifts/sticker/{id}.json.
# Если юзербот выключен, каталог приходит пустым, а слот подарка показывает знак
# приза — приложение не падает.
GIFTS_API_URL=http://127.0.0.1:8090
# Общий секрет юзербота (заголовок X-API-Secret). Порядок тот же, что в юзерботе:
# GIFTS_API_SECRET → MINIAPP_API_SECRET → PAYMENT_RELAY_SECRET. Если ни один не
# задан, юзербот пускает только клиентов с localhost — прокси работает и так.
# GIFTS_API_SECRET=
# GIFTS_CACHE_MS=300000
# Каталог ходит в Telegram: 15 секунд по умолчанию, меньше 5000 не имеет смысла
# (иначе клиент оборвёт запрос раньше, чем юзербот вернёт настоящую причину).
# GIFTS_API_TIMEOUT_MS=15000
# Анимация (.tgs) качается из Telegram при первом показе, поэтому таймаут с запасом.
# GIFTS_STICKER_TIMEOUT_MS=90000

# Премиум-эмодзи (custom emoji) для маркета/склада/профиля: Bot API
# `getCustomEmojiStickers` + кэш файлов. Тот же папкой пользуется команда
# «+стикер» бота (app/owner/emoji_saver.py).
# EMOJI_CACHE_DIR=public/emojis
# EMOJI_TIMEOUT_MS=30000

# Кейсы: куда уходят логи открытий и сбоев выдачи (чат админов и тема в нём).
# Значения по умолчанию зашиты в server/index.js; пусто — лог не отправляется, но
# само открытие кейса работает, а причина сбоя остаётся в журнале сервера.
# CASE_RESULTS_CHAT_ID=-1001284280342
# CASE_RESULTS_THREAD_ID=496436

# Как выдавать подарок из кейса:
#   telegram — уникальный подарок переводит юзербот, обычный бот покупает у
#     Telegram и дарит игроку (по умолчанию; способ виден в логе открытия);
#   internal — прежний внутренний подарок-«мишка» в коллекцию профиля: реальный
#     подарок не покупается (пригодится, пока на балансе бота нет звёзд).
CASE_GIFT_DELIVERY=telegram
# Сколько ждём Telegram на покупке и отправке подарка ботом (мс, минимум 5000).
# CASE_GIFT_SEND_TIMEOUT_MS=20000

# Наполнение раздела «Документация» стартовыми статьями.
# Не задано / topup — при каждом старте добавлять отсутствующие статьи и языковые версии;
# refresh — ещё и обновлять тексты стартовых статей; false — ничего не менять.
DOCS_SEED=

# ── VIP за реальные деньги: карта и СБП через Tribute ─────────────────────────
# Документация: https://wiki.tribute.tg/for-content-creators/api-documentation
# Тарифы — цифровые товары автора («Space VIP — 1 месяц» и т. д.): приложение
# берёт их из `GET /products` (цена и ссылка на оплату у каждого товара), поэтому
# цены и ссылки меняются в кабинете Tribute, а не в коде. Вебхук в кабинете
# (Settings → API Keys → Webhook URL) укажи как
#   https://<домен приложения>/api/tribute/webhook
# Пока ключ не задан, раздел оплаты картой в приложении скрыт, а покупка за
# Telegram Stars работает как раньше.
#
# API key из кабинета Tribute — им же проверяется подпись вебхука (trbt-signature).
TRIBUTE_API_KEY=
# Срок VIP для товаров: id товара из кабинета и дни через двоеточие.
# Необязательно: без карты срок берётся из названия товара («1 месяц» → 30,
# «6 месяцев» → 180, «1 год» → 365). Если карта задана, она же работает списком
# разрешённых товаров — остальные товары автора VIP не продлевают.
# TRIBUTE_VIP_PRODUCTS=171449:30,171450:180,171451:365
# Общая ссылка на оплату для всех тарифов (только https). Необязательно: по
# умолчанию у каждого тарифа своя ссылка товара из каталога.
# TRIBUTE_VIP_LINK=
# Прежний способ — подписка Tribute с автопродлением. Нужен, только если
# владелец продаёт подписку вместо товаров: при наличии товаров VIP приоритет у них.
# TRIBUTE_VIP_SUBSCRIPTION_ID=
# TRIBUTE_VIP_PERIODS=monthly:vip_30,halfyearly:vip_180,yearly:vip_365
# TRIBUTE_API_URL=https://tribute.tg/api/v1
